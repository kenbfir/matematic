# Database — production needs Postgres (e.g. Vercel Postgres, Neon).
# Vercel's filesystem is ephemeral, so SQLite won't persist leads.
DATABASE_URL="postgresql://user:password@host/dbname"

# Email settings — for the contact form notification
# For Gmail: smtp.gmail.com, port 587, and an App Password
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_TO=""

# Analytics — optional. Leave unset to disable. Create these once you're
# ready to run tracked PPC campaigns.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Scanner — Anthropic API + IMAP (uses same Gmail App Password)
ANTHROPIC_API_KEY=""
IMAP_HOST=""
IMAP_PORT=""
IMAP_USER=""
IMAP_PASS=""
SCANNER_EMAIL_TO=""
